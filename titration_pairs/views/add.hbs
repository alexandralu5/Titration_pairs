<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Черновик</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="mobile-body">
  <div class="mobile-container">

    <header class="mobile-header">
      <h2>🧪 Новый опыт</h2>
    </header>

    {{#if draft}}
      <form class="add-card content-with-nav" onsubmit="event.preventDefault()">
        <div class="status-badge">Статус: <span>{{draft.status}}</span></div>

        <!-- Скрытый инпут для фото -->
        <input
          type="file"
          id="imageInput"
          accept="image/*"
          style="display: none;"
          onchange="if(this.files && this.files[0]){ document.getElementById('imgPreview').src = URL.createObjectURL(this.files[0]); }"
        >

        <!-- Поле фото с кликом по изображению -->
        <div class="form-group">
          <label>Фото</label>
          {{#if draft.imageUrl}}
            <img
              id="imgPreview"
              src="{{draft.imageUrl}}"
              alt="Фото из Minio"
              onclick="document.getElementById('imageInput').click()"
              style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; display: block; margin-bottom: 6px; cursor: pointer;"
            >
          {{/if}}
        </div>

        <!-- Скрытый инпут для видео -->
        <input
          type="file"
          id="videoInput"
          accept="video/*"
          style="display: none;"
          onchange="if(this.files && this.files[0]){ document.getElementById('videoPreview').src = URL.createObjectURL(this.files[0]); }"
        >

        <!-- Поле видео с кликом по медиаплееру -->
        <div class="form-group">
          <label>Видео</label>
          {{#if draft.videoUrl}}
            <video
              id="videoPreview"
              src="{{draft.videoUrl}}"
              autoplay
              loop
              muted
              playsinline
              onclick="document.getElementById('videoInput').click()"
              style="width: 75px; height: 133px; object-fit: cover; border-radius: 8px; display: block; margin-bottom: 6px; background: #000; cursor: pointer;"
            ></video>
          {{/if}}
        </div>

        <div class="form-group">
          <label>Название пары</label>
          <input type="text" value="{{draft.title}}">
        </div>

        <div class="form-group">
          <label>Описание</label>
          <textarea rows="2">{{draft.description}}</textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>pH</label>
            <input type="text" value="{{draft.ph}}">
          </div>
          <div class="form-group">
            <label>Концентрация (М)</label>
            <input type="text" value="{{draft.concentration}}">
          </div>
        </div>
      </form>
    {{/if}}

    <!-- Навигация внизу -->
    <nav class="mobile-nav">
      <a href="/feed">Лента</a>
      <a href="/add" class="active">Добавление</a>
      <a href="/grid">Плитка</a>
    </nav>

  </div>
</body>
</html>
