<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Профиль</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="mobile-body">
  <div class="mobile-container">

    <header class="mobile-header">
      <h2>🧪 Профиль</h2>
    </header>

    <div class="add-card">
      <div class="form-group">
        <label>Логин</label>
        <h3 class="add-draft-title">{{user.username}}</h3>
      </div>

      <div class="form-group">
        <label>Роль</label>
        <h3 class="add-draft-title">{{user.role}}</h3>
      </div>

      <button type="button" id="logoutBtn" class="button_primary">Выход</button>
    </div>

    <nav class="mobile-nav">
      <a href="/feed">Лента</a>
      <a href="/add">Добавление</a>
      <a href="/grid">Плитка</a>
    </nav>

  </div>

  <script>
    // Выход: сервер удаляет сессию из Redis и очищает куку sessionId.
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      await fetch('/api/titration_pairs/users/logout', { method: 'POST' });
      window.location.href = '/login';
    });
  </script>
</body>
</html>
